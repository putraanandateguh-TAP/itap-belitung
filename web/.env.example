# iTAP Belitung — variabel lingkungan (NAMA SAJA, tanpa nilai).
# JANGAN pernah menulis nilai kunci asli di file ini atau di repo.
# Isi di .env.local (tidak di-commit) setelah prasyarat P1/P2/P5 dibuat.
# Lihat replica/backend.md untuk instruksi langkah demi langkah.

# --- Supabase (proyek BARU milik Teguh — P1, belum dibuat) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Connection string Postgres (pooler Supabase, port 6543) untuk Drizzle +
# scripts/migrate.ts + scripts/seed.ts. BUKAN anon key.
DATABASE_URL=

# --- URL publik situs (canonical + sitemap + redirect OAuth) ---
NEXT_PUBLIC_SITE_URL=

# --- Email transaksional (Resend, P5 — belum dibuat) ---
# Dipakai sebagai SMTP Supabase Auth (Dashboard Supabase) + lib/email.ts.
RESEND_API_KEY=<redacted>
RESEND_FROM=

# --- WhatsApp OTP via Meta (P2 — belum dibuat; gerbang Fase 2) ---
META_WHATSAPP_TOKEN=<redacted>
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_OTP_TEMPLATE=

# --- Cron job (Vercel Cron -> /api/cron/*) ---
# Nilai bebas (acak panjang) yang sama di Vercel Environment Variables.
CRON_SECRET=

# --- AI iTAP / Penerjemah (Fase 3, P3 — belum dibuat) ---
GEMINI_API_KEY=<redacted>

# --- Firebase Cloud Messaging (Fase 3, P4 — belum dibuat) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Seed / fallback sementara ---
# SEED_AUTHOR_ID = uuid profil admin pemilik konten artikel seed.
SEED_AUTHOR_ID=
# Set "false" setelah P1 + seed jalan, untuk mematikan fallback seed.
ITAP_ALLOW_SEED_FALLBACK=
