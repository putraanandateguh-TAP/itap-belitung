# iTAP Belitung — STAGING environment variables (TEMPLATE).
# NAMA + NILAI DUMMY SAJA. JANGAN isi nilai asli di file ini.
# Salin ke web/.env.staging.local (TIDAK di-commit) dan isi dari
# proyek Supabase STAGING (bukan production itap-belitung).
# Lihat web/docs/STAGING.md §1–§2 untuk cara mendapatkan tiap nilai.

# --- Deployment staging yang diuji ---
STAGING_BASE_URL=https://itap-belitung-staging-example.vercel.app

# --- Supabase STAGING (proyek itap-belitung-staging, ref BARU) ---
STAGING_SUPABASE_URL=https://staging-ref-example.supabase.co
STAGING_SUPABASE_ANON_KEY=staging-anon-key-placeholder
STAGING_SUPABASE_SERVICE_ROLE_KEY=staging-service-role-key-placeholder
# Session pooler staging, port 5432 (BEDA dari production):
STAGING_DATABASE_URL=postgresql://postgres.staging-ref-example:staging-db-password@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres

# --- Cron staging (nilai acak, BERBEDA dari CRON_SECRET production) ---
STAGING_CRON_SECRET=staging-cron-secret-placeholder-ganti-dengan-acak-panjang

# --- Lisensi staging: pepper DUMMY (bukan pepper production!) ---
# Nilai ini HARUS sama dengan secret Edge Function staging:
#   supabase secrets set LICENSE_PEPPER='staging-pepper-dummy-0123456789abcdef' --project-ref <ref-staging>
# Seed lisensi di scripts/seed-staging.sql hash-nya dihitung dari nilai ini.
STAGING_LICENSE_PEPPER=staging-pepper-dummy-0123456789abcdef

# --- Akun test staging (dibuat di Dashboard Auth staging, § STAGING.md §3) ---
# Email HARUS berakhiran .staging-test.invalid agar tidak tertukar akun asli.
STAGING_ADMIN_EMAIL=admin.staging-test@staging-test.invalid
STAGING_ADMIN_PASSWORD=staging-admin-password-placeholder
STAGING_ADMIN_ID=11111111-1111-4111-8111-111111111111
STAGING_BUYER_EMAIL=buyer.staging-test@staging-test.invalid
STAGING_BUYER_PASSWORD=staging-buyer-password-placeholder
STAGING_BUYER_ID=22222222-2222-4222-8222-222222222222
STAGING_READER_EMAIL=reader.staging-test@staging-test.invalid
STAGING_READER_PASSWORD=staging-reader-password-placeholder
STAGING_READER_ID=33333333-3333-4333-8333-333333333333
