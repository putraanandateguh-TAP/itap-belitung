  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.16",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
